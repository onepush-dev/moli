worker_processes 1;
daemon off;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  access_log off;
  server_tokens off;
  client_body_temp_path /tmp/nginx-body;
  proxy_temp_path /tmp/nginx-proxy;
  fastcgi_temp_path /tmp/nginx-fastcgi;
  uwsgi_temp_path /tmp/nginx-uwsgi;
  scgi_temp_path /tmp/nginx-scgi;
  client_max_body_size 64m;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen ${PORT};
    listen [::]:${PORT};
    default_type text/plain;

    # Railway healthcheck: proxied to Moli's own /json/version (loopback).
    location = /healthz {
      proxy_pass http://127.0.0.1:${MOLI_INTERNAL_PORT}/json/version;
      proxy_set_header Host 127.0.0.1:${MOLI_INTERNAL_PORT};
    }
    location = / {
      return 200 "Moli headless browser is running.\nConnect with the secret endpoint https://<this-domain>/t/<MOLI_TOKEN> (see the MOLI_TOKEN / MOLI_CDP_URL variables on Railway).\n";
    }
    # The only route to Moli: CDP, WebDriver Classic and WebDriver BiDi.
    location /t/${MOLI_TOKEN}/ {
      proxy_pass http://127.0.0.1:${MOLI_INTERNAL_PORT}/;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host 127.0.0.1:${MOLI_INTERNAL_PORT};
      proxy_set_header Origin "";
      proxy_set_header Accept-Encoding "";
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
      proxy_buffering off;
      sub_filter_types application/json;
      sub_filter_once off;
      sub_filter 'ws://127.0.0.1:${MOLI_INTERNAL_PORT}/' 'wss://$host/t/${MOLI_TOKEN}/';
      sub_filter 'ws=127.0.0.1:${MOLI_INTERNAL_PORT}/' 'wss=$host/t/${MOLI_TOKEN}/';
    }
    location = /t/${MOLI_TOKEN} { return 301 /t/${MOLI_TOKEN}/; }
    location / { return 404 "not found\n"; }
  }
}
